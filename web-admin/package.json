{
  "name": "cityecho-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-demo-data.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-demo-data.mjs",
    "dev": "next dev",
    "predev:mock": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-demo-data.mjs",
    "dev:mock": "NEXT_PUBLIC_USE_MOCK=1 next dev",
    "dev:https": "next dev --experimental-https",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-demo-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
