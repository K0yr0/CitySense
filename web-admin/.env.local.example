# Copy to .env.local

# FastAPI backend. Use "/api" to go through the Next.js proxy (see next.config.ts),
# which is the easiest way to make phones on HTTPS reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the /api proxy forwards to (server side only). Defaults to http://localhost:8000.
# BACKEND_URL=http://localhost:8000

# 1 = never call the backend, serve the fixtures in lib/mock.ts (any email signs in as a demo admin).
# With 0 the app still falls back to fixtures (and shows a "Demo data" badge) when a request fails.
NEXT_PUBLIC_USE_MOCK=0

# Admin sign-in (docs/ARCHITECTURE.md §8.1). The whole site needs an admin (email in the backend's ADMIN_EMAILS).
# Google web client id; must also be in the backend's GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 1 = show the "sign in with email" form; the backend must have AUTH_DEV_LOGIN=1. Local testing only.
NEXT_PUBLIC_AUTH_DEV_LOGIN=0
