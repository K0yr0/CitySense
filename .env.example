# Copy to .env and fill in. Never commit the real .env.

# Postgres + PostGIS. Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres

# Claude API (triage, photo check, summaries). Leave empty to use keyword fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Warsaw open data user token (the long eyJ... value) for live ZTM vehicle positions,
# sent as the Authorization header to dane.um.warszawa.pl/api/action/get_ztm_lokalizacja_pojazdow
WARSAW_API_KEY=

# Nominatim policy: identify yourself
NOMINATIM_USER_AGENT=cityecho-hackathon (you@example.com)

# Embedding model (needs backend/requirements-ml.txt); hashing fallback otherwise
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# 1 = use cached ZTM snapshot / cached geocodes instead of live calls (safe for the stage)
DEMO_MODE=0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# --- Auth (docs/ARCHITECTURE.md §8) ---
# Google OAuth client ids (Google Cloud Console -> Credentials), comma separated: web, iOS, Android.
# An ID token is accepted when its audience is any of these. Empty = Google login disabled.
GOOGLE_CLIENT_IDS=
# Signing key for our own session tokens (HS256). Generate one:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty = random key per process (every restart logs everyone out).
AUTH_SECRET=
# Session token lifetime in days
AUTH_TOKEN_DAYS=30
# Emails that become role=admin at login, comma separated
ADMIN_EMAILS=
# 1 = enable POST /auth/dev {email} (login without Google) for local testing. Keep 0 in production.
AUTH_DEV_LOGIN=0

# --- Simulated vehicles (POST /devices/stream, owner C) ---
# Comma separated device_id:secret pairs; the device sends "X-Device-Key: <device_id>:<secret>".
# Ids name the simulated line: bus-<MAR|JER|SWI>-NN or tram-17-NN (scripts/simulate_buses.py). Pick your own
# secrets. The stage scenarios need bus-JER-01, bus-JER-02, bus-SWI-01, bus-SWI-02, e.g.:
# bus-MAR-01:<secret>,bus-MAR-02:<secret>,bus-JER-01:<secret>,bus-JER-02:<secret>,bus-SWI-01:<secret>,bus-SWI-02:<secret>,tram-17-01:<secret>,tram-17-02:<secret>
DEVICE_KEYS=

# Web admin (web-admin/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_USE_MOCK=0
