# Copy to .env and fill in. Never commit the real .env.

# Postgres + PostGIS. Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres

# Claude API (triage, photo check, summaries). Leave empty to use keyword fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Warsaw open data API key (api.um.warszawa.pl) for live ZTM vehicle positions
WARSAW_API_KEY=
# ZTM_RESOURCE_ID=f2e5503e-927d-4ad3-9500-4ab9e55deb59

# Nominatim policy: identify yourself
NOMINATIM_USER_AGENT=cityecho-hackathon (you@example.com)

# Embedding model (needs backend/requirements-ml.txt); hashing fallback otherwise
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# 1 = use cached ZTM snapshot / cached geocodes instead of live calls (safe for the stage)
DEMO_MODE=0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_USE_MOCK=0
