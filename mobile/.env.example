# Backend address. When empty, http://localhost:8000 is used (web / simulator only).
# On a phone (Expo Go) use your computer's LAN IP, e.g. http://192.168.1.20:8000
# Copy: cp .env.example .env   (after changing it: npx expo start --clear)
EXPO_PUBLIC_API_URL=

# Google sign-in (M2). Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# The same ids must also be listed (comma-separated) in GOOGLE_CLIENT_IDS in the backend .env.
# Google sign-in doesn't work in Expo Go: iOS/Android need a development build (npx expo run:ios|android).
# On a platform left empty the Google button is disabled; demo sign-in always works (backend AUTH_DEV_LOGIN=1).
# Web client (npx expo start --web): authorized redirect URI http://localhost:8081/sign-in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client (bundle id = app.json ios.bundleIdentifier)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android client (package name = app.json android.package, SHA-1 of the signing certificate)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
