# Backend adresi. Boş bırakılırsa http://localhost:8000 kullanılır (yalnızca web / simülatör).
# Telefonda (Expo Go) bilgisayarın LAN IP'sini yaz, ör. http://192.168.1.20:8000
# Kopyala: cp .env.example .env   (değiştirdikten sonra: npx expo start --clear)
EXPO_PUBLIC_API_URL=

# Google girişi (M2). Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Aynı id'ler backend .env içindeki GOOGLE_CLIENT_IDS listesine (virgülle) de yazılmalı.
# Expo Go'da Google girişi çalışmaz: iOS/Android için geliştirme derlemesi gerekir (npx expo run:ios|android).
# Boş bırakılan platformda Google düğmesi kapalı görünür; "Demo girişi" her zaman çalışır (backend AUTH_DEV_LOGIN=1).
# Web istemcisi (npx expo start --web): yetkili yönlendirme adresi http://localhost:8081/sign-in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS istemcisi (bundle id = app.json ios.bundleIdentifier)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android istemcisi (paket adı = app.json android.package, imza sertifikasının SHA-1'i)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
