# Copy to .env.local

# FastAPI backend. Use "/api" to go through the Next.js proxy (see next.config.ts),
# which is the easiest way to make phones on HTTPS reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the /api proxy forwards to (server side only). Defaults to http://localhost:8000.
# BACKEND_URL=http://localhost:8000

# 1 = never call the backend, serve the fixtures in lib/mock.ts.
# With 0 the app still falls back to fixtures (and shows a "Demo data" badge) when a request fails.
NEXT_PUBLIC_USE_MOCK=0
